# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Used by docker-compose and the HMS server (see README §15).

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hms

# --- Security ---
# Secret that signs sessions/tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me

# Initial password for the `admin` account on hotel 0 (forced change on first login)
ADMIN_BOOTSTRAP_PASSWORD=dev-only-change-me

# Login attempts allowed per window before rate limiting kicks in
RATE_LIMIT_LOGIN=10

# --- Desktop offline login ---
# How long cached desktop credentials stay valid (days)
OFFLINE_LOGIN_DAYS=14

# --- Sync protocol ---
# Oldest desktop sync protocol version the server still accepts
SYNC_PROTOCOL_MIN_VERSION=1

# --- Reference-site credentials (feature inventory only, never commit real ones) ---
# Site 2 = app.hms.gen.tr (HMS Hotel Software)
SITE2_HOTEL_CODE=
SITE2_USERNAME=
SITE2_PASSWORD=
