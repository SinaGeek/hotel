# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Used by docker-compose and the HMS server (see README §15).

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hms

# --- Security ---
# Exact comma-separated browser origins. Development defaults to Vite localhost origins;
# production must set the real HTTPS web origin(s). Wildcards and paths are rejected.
CORS_ALLOWED_ORIGINS=
# APP_ENV=production disables the localhost default when no CORS list is configured.
APP_ENV=development
# Secret that signs sessions/tokens. Production requires at least 32 bytes.
# Generate with: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me
# Key for guest identity field encryption at rest. Base64-encoded 32 bytes.
# Generate with: openssl rand -hex 32
GUEST_FIELD_ENCRYPTION_KEY=

# Initial password for the `admin` account on hotel 0 (forced change on first login)
ADMIN_BOOTSTRAP_PASSWORD=dev-only-change-me

# Login attempts allowed per window before rate limiting kicks in
RATE_LIMIT_LOGIN=10

# --- Desktop offline login ---
# How long cached desktop credentials stay valid (days)
OFFLINE_LOGIN_DAYS=14

# --- Sync protocol ---
# Oldest desktop sync protocol version the server still accepts
SYNC_PROTOCOL_MIN_VERSION=1

# --- Reference-site credentials (feature inventory only, never commit real ones) ---
# Site 2 = app.hms.gen.tr (HMS Hotel Software)
SITE2_HOTEL_CODE=
SITE2_USERNAME=
SITE2_PASSWORD=
