# Rust (both workspaces build into their own target dirs)
/target/
server/target/
client/target/
**/src-tauri/target/
**/*.rs.bk
Cargo.lock.tmp

# Node / web
node_modules/
dist/
client/web/dist/
*.tsbuildinfo
*.local

# Environment / secrets
.env
.env.*
!.env.example
userpass.md

# Captured reference-site artifacts / reverse-engineering scratch (never ship)
*.min.js.bak
*.http
flow_*.js
inspect_*.py
/screenshots/

# Local installers and build deliverables (regenerate, do not commit)
/postgresql-*.exe
/release/

# Editor / OS
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Tauri generated schemas (regenerated by every tauri build)
client/desktop/src-tauri/gen/

# local run logs
*.log

# generated OpenAPI bundle (F2): regenerate with pnpm gen:api
/client/web/src/types/generated/openapi.json

# local dev-stack state (pids/logs/secret/update host staging)
.stack/
