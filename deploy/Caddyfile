# Caddy reference config: TLS termination + static SPA + API proxy.
# Caddy obtains and renews Let's Encrypt certificates automatically.
#
#   hms.example.com {
#       root * /srv/hms/web
#       encode gzip zstd
#       @api path /api/* /health /metrics
#       handle @api {
#           reverse_proxy hms-server:8080
#       }
#       handle {
#           try_files {path} /index.html
#           file_server
#       }
#   }
#
# Notes
# - `/metrics` is deliberately on the same host above; restrict it at the
#   firewall or add a separate internal-only site block if the scraper is remote.
# - `root` points at the built web bundle (`apps/web/dist`), not the sources.

hms.example.com {
	root * /srv/hms/web
	encode gzip zstd

	@api path /api/* /health /metrics
	handle @api {
		reverse_proxy hms-server:8080
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
