# Caddy config for the *no-Docker local verifications* (TODOS E2 / E6):
# the same TLS-termination, SPA-deep-link, /api-proxy and static-update-host
# shape as deploy/Caddyfile, but with Caddy's internal local CA instead of
# Let's Encrypt and loopback hostnames.
#
# This shell is non-elevated, so hosts-file names (hms.local /
# updates.hms.example) are unavailable; the loopback fallback uses the same
# ports structure: :8443 = SPA + API, :9443 = static update host.
#
# Prereqs:
#   - web bundle built: apps/web/dist (pnpm --filter web build)
#   - update manifest staged: .stack/updates/desktop/latest.json
#   - server running on 127.0.0.1:8080 (scripts/dev-stack.ps1)
#
# Start: caddy run --config deploy\Caddyfile.local   (workdir = repo root)
#    or .\scripts\dev-stack.ps1 -WithCaddy
# Stop:  caddy stop / kill the pid from .stack/caddy.pid

{
	local_certs
	http_port 8081
	https_port 8443
}

# SPA + API behind TLS, mirroring the production site block in deploy/Caddyfile.
localhost:8443 {
	tls internal
	encode gzip zstd

	@api path /api/* /health /metrics
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * ./apps/web/dist
		try_files {path} /index.html
		file_server
	}
}

# Desktop update host: `latest.json` + signed installer, nothing else.
localhost:9443 {
	tls internal
	root * ./.stack/updates

	# never cache the manifest: a stale one hides a new release
	@manifest path /desktop/latest.json
	header @manifest Cache-Control "no-store"
	file_server

	log {
		output discard
	}
}
