{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HMS Desktop",
  "version": "0.1.0",
  "identifier": "com.hms.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "HMS — Hotel Management",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}
